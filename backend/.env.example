HF_API_TOKEN=
GROQ_API_KEY=
DATABASE_URL=sqlite:///./app.db
UPSTASH_REDIS_URL=redis://localhost:6379/0
STORAGE_QUOTA_BYTES=524288000
API_KEY=dev-api-key
TRIPO_API_KEY=

# Storage backend: "local" (default) or "gcs" (Google Cloud Storage)
STORAGE_BACKEND=local
BACKEND_BASE_URL=http://localhost:8000

# --- Google Cloud Storage (required when STORAGE_BACKEND=gcs) ---
# GCS_BUCKET_NAME=your-bucket-name
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# OR: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
