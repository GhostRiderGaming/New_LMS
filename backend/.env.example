# ─── Required API Keys ────────────────────────────────────────────────────────
# Groq API key — powers ALL LLM features (prompts, safety, Bella chat, STT)
# Get a free key: https://console.groq.com
GROQ_API_KEY=

# API authentication key for the backend. Frontend sends this with every request.
# Change this in production!
API_KEY=dev-api-key

# ─── Database & Cache ─────────────────────────────────────────────────────────
# SQLAlchemy database URL (default: SQLite, no setup needed)
DATABASE_URL=sqlite:///./app.db

# Redis URL for Celery task queue. If Redis is unavailable, jobs run in-process.
UPSTASH_REDIS_URL=redis://localhost:6379/0

# ─── Optional API Keys ───────────────────────────────────────────────────────
# Hugging Face API token — used for 3D model generation (FLUX.1 + stable-fast-3d)
# Get a free token: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# ─── Image Search (for Smart Image Resolver) ─────────────────────────────────
# Uses Wikimedia Commons API — completely free, no API key needed.
# Millions of CC-licensed educational diagrams available.
# No configuration required.

# ─── Storage ──────────────────────────────────────────────────────────────────
# "local" (default, saves to ./storage/) or "gcs" (Google Cloud Storage)
STORAGE_BACKEND=local

# Base URL of the backend server — used for constructing asset download URLs
BACKEND_BASE_URL=http://localhost:8000

# Per-session storage quota in bytes (default: 500 MB = 524288000)
STORAGE_QUOTA_BYTES=524288000

# ─── Google Cloud Storage (required when STORAGE_BACKEND=gcs) ────────────────
# GCS_BUCKET_NAME=your-bucket-name
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# OR: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── CORS (Production) ──────────────────────────────────────────────────────
# Comma-separated additional CORS origins (localhost:3000 is always allowed)
# Example: CORS_ORIGINS=https://myapp.example.com,https://staging.example.com
# CORS_ORIGINS=
